work/
outputs/
*.zip

# Local Python env for the CPU redaction backend (Presidio + spaCy, ~800MB).
.venv/

# Review artefacts that contain unredacted source text. These are generated
# into the served directory, so an ignore rule is the only thing standing
# between a local review aid and a published one.
viewer/public/redaction-diff.html
redaction-diff.html
*-dialogue/
*-probes/
*-redaction/
*-applied/
*-case*/
*-release/
# Catch-all at any depth, so a node project added elsewhere in the kit is
# covered without another edit here.
node_modules/

# The same two paths without a trailing slash: on a shared host they are
# symlinks into a prepull cache, and a trailing slash matches only real
# directories -- committing the symlink would leak an internal absolute path.
viewer/node_modules
viewer/.wrangler
viewer/.vinext/
viewer/dist/
viewer/.dev.vars
viewer/.oxygen-local.json
tools/ingest/out/
tools/ingest/webapp-data/
tools/ingest/.venv-audio/
__pycache__/

